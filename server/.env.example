NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres@localhost:5432/orgpm
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-access
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
DEFAULT_TIMEZONE=Asia/Kolkata
RUN_WORKERS_IN_API=true
LOG_LEVEL=info
# First super admin for a fresh production database (used by `npm run seed:prod`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OrgPM <no-reply@example.com>
# --- Browser push: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# --- Mobile push (Firebase Cloud Messaging HTTP v1) ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# --- WhatsApp (Meta WhatsApp Cloud API) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
