# ---- docker compose ----
WEB_PORT=8080
POSTGRES_DB=orgpm
POSTGRES_USER=orgpm
POSTGRES_PASSWORD=change-me-strong-app-db-password
# Superuser for administration only (backups etc.). The app connects as POSTGRES_USER, a non-superuser,
# because PostgreSQL superusers bypass the row-level security that isolates tenants.
POSTGRES_ADMIN_PASSWORD=change-me-strong-admin-password

# ---- API / worker (see server/.env.example for every option) ----
JWT_ACCESS_SECRET=change-me-64-random-chars-access
JWT_REFRESH_SECRET=change-me-64-random-chars-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
APP_URL=https://orgpm.example.com
CORS_ORIGINS=https://orgpm.example.com
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
# Let anyone create a new organization (tenant) from the sign-in page
ALLOW_REGISTRATION=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-first-admin-password

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OrgPM <no-reply@example.com>
# Browser push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Mobile push (Firebase Cloud Messaging HTTP v1)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# WhatsApp (Meta WhatsApp Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
